# skein — every skill reads its targets from here. Nothing is hardcoded.
GRAPH_URL=http://your-graph.example      # quipu / graph-extract / graph-report
GRAPH_GROUP=my-ontology                  # graph partition to write into
SEARCH_URL=http://your-search.example    # optional — semantic code search
DB_HOST=your-db.example                  # optional — data plane
BEADS_DB=your_issues_db                  # optional — issue tracker db
